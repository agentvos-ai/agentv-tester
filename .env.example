# LLM API Keys
GOOGLE_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_claude_api_key_here
GROK_API_KEY=your_grok_api_key_here

# Optional: Suite Configuration Overrides
ACTIVE_VERTICAL=fintech
ACTIVE_FRAMEWORK=langgraph
ACTIVE_LLM=gemini

# Optional: Server Configuration
PORT=8080
LOG_LEVEL=INFO

# Optional SMTP delivery for healthcare provider notifications.
# When notification_channel=email, SMTP_HOST is required; without it the durable
# notification record is marked NOT_CONFIGURED rather than SENT.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=notifications@example.com
